---
/**
 * PÁGINA DE TOUR — layout ref. Vita /retreat, "Lo que harás" ref. Airbnb.
 * Portada: migas + titular + galería en mosaico (61 / 19.5 / 19.5).
 * Cuerpo: contenido a la izquierda; ficha fija a la derecha con datos,
 * acción de reserva e índice de secciones que sigue el scroll.
 */
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import ContactSection from '@/components/ContactSection.astro';
import Viewer, { type Slide } from '@/components/tour/Viewer.astro';
import Photo from '@/components/Photo.astro';
import { tours, tourCategories, ui, contact, type Lang, type Tour, type Img } from '@/content/site';
import { tr, rich, href, langs, defaultLang } from '@/lib/i18n';

export function getStaticPaths() {
  return langs.flatMap((lang) =>
    tours
      .filter((tour) => tour.hasDetail)
      .map((tour) => ({
        params: { lang: lang === defaultLang ? undefined : lang, slug: tour.slug },
        props: { lang, tour },
      })),
  );
}
const { lang, tour } = Astro.props as { lang: Lang; tour: Tour };
const d = tour.detail!;
const name = tr(tour.name, lang);

// Galería: fotos propias; si no hay, la portada gráfica del tour.
const photos: Img[] = d.gallery.length ? d.gallery : tour.cover ? [tour.cover] : [];
const mosaic = photos.slice(0, 4);
const gallerySlides: Slide[] = photos.map((image) => ({ image }));
const stopSlides: Slide[] = d.stops.map((s) => ({ image: s.image, title: s.title, text: s.text }));

const whatsappHref = `${contact.whatsapp}?text=${encodeURIComponent(`${tr(ui.whatsappTourMsg, lang)}: ${name}`)}`;

const sections = [
  { id: 'descripcion', label: ui.description },
  { id: 'lo-que-haras', label: ui.whatYouDo },
  ...(photos.length > 1 ? [{ id: 'galeria', label: ui.gallery }] : []),
  { id: 'incluye', label: ui.includes },
  { id: 'itinerario', label: ui.itinerary },
  { id: 'contacto', label: ui.bookSection },
];
---
<Base lang={lang} title={tour.name} description={tour.summary}>
  <!-- ============ Portada ============ -->
  <section class="intro container" aria-labelledby="tour-titulo">
    <nav class="crumbs" aria-label={tr(ui.breadcrumb, lang)}>
      <a href={href('/tours', lang)}>{tr(ui.breadcrumbTours, lang)}</a>
      <Icon name="chevronRight" size={14} />
      <span aria-current="page">{name}</span>
    </nav>
    <div class="intro__head">
      <p class="intro__meta">
        <span class="tag">{tr(tourCategories[tour.category], lang)}</span>
        <span><Icon name="clock" size={16} /> {tour.duration} {tr(ui.hours, lang)}</span>
        <span><Icon name="pin" size={16} /> {tr(tour.region, lang)}</span>
      </p>
      <h1 id="tour-titulo" class="intro__title">{name}</h1>
      <p class="intro__subtitle">{tr(d.subtitle, lang)}</p>
    </div>

    <div class:list={['mosaic', `mosaic--${mosaic.length || 'banner'}`]}>
      {mosaic.length ? (
        mosaic.map((p, i) => (
          <button class="mosaic__item" type="button" data-viewer-open="visor-galeria" data-index={i}>
            <Photo src={p.src} alt={tr(p.alt, lang)} sizes={i === 0 ? '(max-width: 48rem) 100vw, 60vw' : '(max-width: 48rem) 100vw, 40vw'} widths={[480, 720, 960, 1280, 1600]} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />
          </button>
        ))
      ) : (
        <div class="mosaic__item mosaic__item--banner">
          <Photo src={tour.banner} alt={name} sizes="100vw" loading="eager" fetchpriority="high" />
        </div>
      )}
      {photos.length > 1 && (
        <button class="btn btn--on-photo mosaic__all" type="button" data-viewer-open="visor-galeria" data-index="0">
          <Icon name="images" size={18} /> {tr(ui.seePhotos, lang)} ({photos.length})
        </button>
      )}
    </div>
  </section>

  <!-- ============ Cuerpo ============ -->
  <div class="body container">
    <aside class="side" aria-label={name}>
      <div class="side__card">
        <dl class="side__facts">
          <div><dt>{tr(ui.duration, lang)}</dt><dd>{tour.duration} {tr(ui.hours, lang)}</dd></div>
          <div><dt>{tr(ui.region, lang)}</dt><dd>{tr(tour.region, lang)}</dd></div>
          <div class="side__wide"><dt>{tr(ui.departures, lang)}</dt><dd>{tr(d.departures, lang)}</dd></div>
        </dl>
        <p class="side__price">{tr(ui.priceOnRequest, lang)}</p>
        <div class="side__actions">
          <a class="btn btn--primary" href="#contacto">{tr(ui.bookThisTour, lang)} <Icon name="arrow" /></a>
          <a class="btn" href={whatsappHref} target="_blank" rel="noopener"><Icon name="whatsapp" /> {tr(ui.askWhatsapp, lang)}</a>
        </div>
      </div>
      <nav class="toc" aria-label={tr(ui.onThisPage, lang)} data-toc>
        <p class="kicker toc__title">{tr(ui.onThisPage, lang)}</p>
        <ul role="list">
          {sections.map((s) => (
            <li><a href={`#${s.id}`} data-toc-link={s.id}>{tr(s.label, lang)}</a></li>
          ))}
        </ul>
      </nav>
    </aside>

    <div class="content">
      <section id="descripcion" class="block" aria-labelledby="h-desc">
        <h2 id="h-desc" class="block__title">{tr(ui.description, lang)}</h2>
        <div class="prose">
          {d.body.map((p) => <p set:html={rich(tr(p, lang))} />)}
        </div>
        <p class="note"><Icon name="pin" size={16} /> {tr(d.departures, lang)}</p>
      </section>

      <section id="lo-que-haras" class="block" aria-labelledby="h-stops">
        <h2 id="h-stops" class="block__title">{tr(ui.whatYouDo, lang)}</h2>
        <ol class="stops" role="list">
          {d.stops.map((s, i) => (
            <li>
              <button class="stop" type="button" data-viewer-open="visor-paradas" data-index={i}>
                <span class="stop__thumb">
                  {s.image
                    ? <Photo src={s.image.src} alt="" sizes="96px" widths={[192]} />
                    : <span class="stop__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>}
                </span>
                <span class="stop__text">
                  <span class="stop__title">{tr(s.title, lang)}</span>
                  {s.text && <span class="stop__desc">{tr(s.text, lang)}</span>}
                </span>
                <Icon name="chevronRight" size={18} />
              </button>
            </li>
          ))}
        </ol>
      </section>

      {photos.length > 1 && (
        <section id="galeria" class="block" aria-labelledby="h-gal">
          <h2 id="h-gal" class="block__title">{tr(ui.gallery, lang)}</h2>
          <ul class="gallery" role="list">
            {photos.map((p, i) => (
              <li>
                <button type="button" data-viewer-open="visor-galeria" data-index={i}>
                  <Photo src={p.src} alt={tr(p.alt, lang)} sizes="(max-width: 48rem) 45vw, 260px" widths={[320, 520]} />
                </button>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section id="incluye" class="block" aria-labelledby="h-inc">
        <h2 id="h-inc" class="block__title">{tr(ui.includes, lang)}</h2>
        <div class="incl">
          <ul role="list" class="incl__list">
            {d.includes.map((x) => <li><span class="incl__icon incl__icon--yes"><Icon name="check" size={16} /></span>{tr(x, lang)}</li>)}
          </ul>
          <div>
            <h3 class="incl__sub">{tr(ui.excludes, lang)}</h3>
            <ul role="list" class="incl__list">
              {d.excludes.map((x) => <li><span class="incl__icon"><Icon name="minus" size={16} /></span>{tr(x, lang)}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <section id="itinerario" class="block" aria-labelledby="h-iti">
        <h2 id="h-iti" class="block__title">{tr(ui.itinerary, lang)}</h2>
        <ol class="timeline" role="list">
          {d.itinerary.map((step) => (
            <li>
              <p class="timeline__label">{tr(step.label, lang)}</p>
              <p class="timeline__value">{tr(step.value, lang)}</p>
            </li>
          ))}
        </ol>
        <p class="meta">{tr(ui.serviceNote, lang)}</p>
      </section>
    </div>
  </div>

  <ContactSection lang={lang} form subject={name} />

  {photos.length > 0 && <Viewer id="visor-galeria" slides={gallerySlides} lang={lang} label={`${tr(ui.gallery, lang)} · ${name}`} />}
  <Viewer id="visor-paradas" slides={stopSlides} lang={lang} label={`${tr(ui.whatYouDo, lang)} · ${name}`} />
</Base>

<style>
  /* ---------- Portada ---------- */
  .intro { display: grid; gap: var(--space-l); }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--step--1);
    color: var(--ink-3);
  }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { color: var(--ink); text-decoration: underline; }
  .crumbs [aria-current] { color: var(--ink-2); }
  .intro__head { display: grid; gap: var(--space-s); max-width: 60rem; }
  .intro__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-m);
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .intro__meta > span:not(.tag) { display: inline-flex; align-items: center; gap: 0.4em; }
  .intro__title {
    font-size: var(--step-5);
    font-weight: var(--w-light);
    letter-spacing: var(--track-display);
    line-height: 1;
  }
  .intro__subtitle { font-size: var(--step-1); color: var(--ink-2); max-width: 52ch; }

  /* Mosaico 61 / 19.5 / 19.5 (ref. Vita) */
  .mosaic {
    position: relative;
    display: grid;
    gap: var(--space-s);
    height: clamp(20rem, 40vw, 34rem);
  }
  .mosaic--4 { grid-template-columns: 61fr 19.5fr 19.5fr; grid-template-rows: 1fr 1fr; }
  .mosaic--4 > :nth-child(1) { grid-row: 1 / 3; }
  .mosaic--4 > :nth-child(2) { grid-column: 2 / 4; }
  .mosaic--3 { grid-template-columns: 61fr 39fr; grid-template-rows: 1fr 1fr; }
  .mosaic--3 > :nth-child(1) { grid-row: 1 / 3; }
  .mosaic--2 { grid-template-columns: 61fr 39fr; }
  .mosaic--1, .mosaic--banner { grid-template-columns: 1fr; }
  .mosaic--banner { height: auto; }
  .mosaic__item {
    position: relative;
    display: block;
    min-height: 0;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--bg-sunk);
  }
  .mosaic__item :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s var(--ease-out), filter var(--dur-2) var(--ease-out); }
  .mosaic__item--banner :global(img) { height: auto; aspect-ratio: 1350 / 440; }
  @media (hover: hover) {
    button.mosaic__item:hover :global(img) { transform: scale(1.03); filter: brightness(0.92); }
  }
  .mosaic__all { position: absolute; right: var(--space-m); bottom: var(--space-m); box-shadow: var(--shadow-2); }

  /* ---------- Cuerpo ---------- */
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 24rem);
    gap: clamp(var(--space-xl), 6vw, 6rem);
    padding-block: var(--space-2xl) var(--space-section);
  }
  .content { grid-column: 1; grid-row: 1; display: grid; gap: var(--space-2xl); }

  .side { grid-column: 2; grid-row: 1; }
  .side {
    position: sticky;
    top: calc(3.5rem + var(--space-xs) * 2 + var(--space-l));
    align-self: start;
    display: grid;
    gap: var(--space-l);
  }
  .side__card {
    position: static;
    display: grid;
    gap: var(--space-m);
    padding: var(--space-l);
    border-radius: var(--r-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-1);
  }
  .side__facts { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-s) var(--space-m); }
  .side__facts dt { font-size: var(--step--1); color: var(--ink-3); }
  .side__facts dd { font-weight: 650; }
  .side__wide { grid-column: 1 / -1; }
  .side__wide dd { font-weight: var(--w-regular); color: var(--ink-2); }
  .side__price { font-size: var(--step--1); color: var(--ink-3); padding-top: var(--space-s); border-top: 1px solid var(--line); }
  .side__actions { display: grid; gap: var(--space-2xs); }
  .toc { position: static; padding-left: var(--space-l); border-left: 1px solid var(--line); }
  .toc__title { margin-bottom: var(--space-xs); }
  .toc ul { display: grid; gap: 0.15rem; }
  .toc a {
    display: block;
    padding-block: 0.3rem;
    font-size: var(--step-1);
    font-weight: var(--w-medium);
    letter-spacing: var(--track-heading);
    text-decoration: none;
    color: var(--ink);
    opacity: 0.4;
    transition: opacity var(--dur-2) var(--ease-out);
  }
  .toc a:hover, .toc a[aria-current='true'] { opacity: 1; }

  /* ---------- Bloques ---------- */
  .block { display: grid; gap: var(--space-m); scroll-margin-top: calc(3.5rem + var(--space-2xl)); }
  .block__title {
    font-size: var(--step-3);
    font-weight: var(--w-bold);
    letter-spacing: var(--track-heading);
    line-height: 1.1;
    padding-top: var(--space-l);
    border-top: 1px solid var(--line);
  }
  #descripcion .block__title { border-top: 0; padding-top: 0; }
  .note { display: inline-flex; align-items: center; gap: 0.5em; font-weight: var(--w-medium); }

  /* Lo que harás (ref. Airbnb): miniatura 96px, radio 16px, gap 24px */
  .stops { display: grid; gap: var(--space-2xs); max-width: 40rem; }
  .stop {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-m);
    width: 100%;
    padding: 0.25rem;
    padding-right: var(--space-s);
    border-radius: var(--r-lg);
    text-align: left;
    color: var(--ink-3);
    transition: background-color var(--dur-1) var(--ease-out);
  }
  @media (hover: hover) { .stop:hover { background: var(--bg-sunk); } }
  .stop__thumb {
    display: grid;
    place-items: center;
    width: 6rem;
    height: 6rem;
    border-radius: 1rem;
    overflow: hidden;
    background: var(--bg-sunk);
  }
  .stop:hover .stop__thumb { background: var(--surface); }
  .stop__thumb :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .stop__num { font-size: var(--step-2); font-weight: var(--w-light); letter-spacing: var(--track-heading); color: var(--ink-3); }
  .stop__text { display: grid; gap: 0.2rem; }
  .stop__title { font-weight: 650; color: var(--ink); }
  .stop__desc { font-size: var(--step--1); color: var(--ink-2); }

  /* Galería */
  .gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-s); }
  .gallery button { display: block; width: 100%; aspect-ratio: 1; border-radius: var(--r-md); overflow: hidden; }
  .gallery :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s var(--ease-out); }
  @media (hover: hover) { .gallery button:hover :global(img) { transform: scale(1.05); } }

  /* Incluye / No incluye */
  .incl { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-l) var(--space-xl); }
  .incl__sub { font-size: var(--step-0); margin-bottom: var(--space-s); color: var(--ink-2); font-weight: 650; }
  .incl__list { display: grid; gap: var(--space-xs); }
  .incl__list li { display: grid; grid-template-columns: auto 1fr; gap: var(--space-xs); align-items: start; }
  .incl__icon {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--r-pill);
    border: 1px solid var(--line-strong);
    color: var(--ink-3);
  }
  .incl__icon--yes { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }

  /* Itinerario: línea con hitos */
  .timeline { display: grid; gap: 0; max-width: 40rem; }
  .timeline li {
    position: relative;
    display: grid;
    gap: 0.15rem;
    padding: 0 0 var(--space-m) var(--space-l);
  }
  .timeline li::before {
    content: '';
    position: absolute;
    left: 0.3rem;
    top: 0.45rem;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--ink);
  }
  .timeline li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(0.3rem + 0.325rem - 0.5px);
    top: 1.25rem;
    bottom: 0.1rem;
    width: 1px;
    background: var(--line-strong);
  }
  .timeline__label { font-weight: 650; }
  .timeline__value { color: var(--ink-2); }

  /* ---------- Responsive ---------- */
  @media (max-width: 64rem) {
    .body { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); padding-top: var(--space-l); }
    .side { position: static; grid-column: 1; grid-row: 1; }
    .content { grid-row: 2; }
    .toc {
      position: sticky;
      top: calc(3.5rem + var(--space-xs) * 2);
      z-index: 5;
      margin-inline: calc(var(--gutter) * -1);
      padding: var(--space-2xs) var(--gutter);
      border: 0;
      border-bottom: 1px solid var(--line);
      background: var(--glass);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
    }
    .side { display: contents; }
    .side__card { grid-row: 1; }
    .toc { grid-row: 2; }
    .content { grid-row: 3; }
    .toc__title { display: none; }
    .toc ul { display: flex; gap: var(--space-m); overflow-x: auto; scrollbar-width: none; }
    .toc a { font-size: var(--step--1); white-space: nowrap; }
  }
  @media (max-width: 48rem) {
    .mosaic { height: auto; grid-template-columns: 1fr !important; grid-template-rows: none !important; }
    .mosaic > .mosaic__item:not(:first-child) { display: none; }
    .mosaic__item { aspect-ratio: 4 / 3; grid-row: auto !important; grid-column: auto !important; }
    .mosaic__item--banner { aspect-ratio: auto; }
    .incl { grid-template-columns: 1fr; }
    .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stop { grid-template-columns: 4.5rem minmax(0, 1fr) auto; gap: var(--space-s); }
    .stop__thumb { width: 4.5rem; height: 4.5rem; }
  }
</style>

<script>
  // Índice de secciones: resalta la sección visible (scrollspy).
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const targets = links
    .map((a) => document.getElementById(a.dataset.tocLink!))
    .filter((el): el is HTMLElement => Boolean(el));
  let active = '';
  const setActive = (id: string) => {
    if (id === active) return;
    active = id;
    links.forEach((a) => {
      const on = a.dataset.tocLink === id;
      a.setAttribute('aria-current', String(on));
      if (on && a.closest('ul')!.scrollWidth > a.closest('ul')!.clientWidth) {
        a.scrollIntoView({ block: 'nearest', inline: 'center' });
      }
    });
  };
  const onScroll = () => {
    const line = innerHeight * 0.3;
    let current = targets[0]?.id;
    for (const t of targets) if (t.getBoundingClientRect().top <= line) current = t.id;
    if (current) setActive(current);
  };
  let raf = 0;
  addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(() => { raf = 0; onScroll(); }); }, { passive: true });
  onScroll();
</script>
