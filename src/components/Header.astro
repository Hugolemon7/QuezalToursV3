---
/**
 * CABECERA — ref. Lightship
 * Orden: logo a la izquierda, secciones al centro, herramientas a la derecha.
 * Arriba: barra a todo el ancho, sin fondo (texto blanco si hay foto debajo).
 * Al hacer scroll: los grupos se recogen hacia el centro y aparece una
 * píldora de vidrio esmerilado (clip horizontal + blur), el logo se reduce.
 * Todo lo mueve una sola variable, --p (0 → 1), interpolada con rAF.
 * Móvil (<68rem): logo + botón de menú; el menú es un <dialog> a pantalla completa.
 */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { nav, ui, contact, type Lang } from '@/content/site';
import { tr, href, switchLang, langs } from '@/lib/i18n';

interface Props {
  lang: Lang;
  /** La página empieza con una foto a sangre: texto blanco arriba. */
  overHero?: boolean;
}
const { lang, overHero = false } = Astro.props;
const path = Astro.url.pathname;
const bare = path.replace(/^\/en(?=\/|$)/, '') || '/';
const isCurrent = (h: string) => bare === h || bare.startsWith(`${h}/`);
const whatsapp = contact.phones.find((p) => 'whatsapp' in p);
const phone = contact.phones.find((p) => !('whatsapp' in p));
---
<header class="hd" data-header data-over-hero={overHero ? '' : undefined}>
  <div class="hd__bar">
    <div class="hd__bg" aria-hidden="true"></div>
    <a class="hd__logo" href={href('/', lang)} aria-label={tr(ui.homeLink, lang)}>
      <Logo />
    </a>

    <nav class="hd__group hd__group--center" aria-label={tr(ui.menu, lang)}>
      <ul class="hd__nav" role="list">
        {nav.map((item) => (
          <li>
            <a
              class="hd__link"
              href={href(item.href, lang)}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >{tr(item.label, lang)}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hd__group hd__group--end">
      <div class="hd__lang" role="group" aria-label={tr(ui.language, lang)}>
        {langs.map((l) => (
          <a href={switchLang(path, l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>
            {l.toUpperCase()}
          </a>
        ))}
      </div>
      <ThemeToggle lang={lang} />
      <a class="btn btn--primary hd__cta" href="#contacto">{tr(ui.bookCta, lang)}</a>
      <button
        class="hd__burger"
        type="button"
        data-menu-open
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="menu-movil"
      >
        <span class="visually-hidden">{tr(ui.openMenu, lang)}</span>
        <span class="hd__burger-lines" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<dialog class="menu" id="menu-movil" aria-label={tr(ui.menu, lang)} data-menu>
  <div class="menu__top">
    <a class="menu__logo" href={href('/', lang)} aria-label={tr(ui.homeLink, lang)}><Logo /></a>
    <button class="menu__close" type="button" data-menu-close>
      <Icon name="close" size={22} label={tr(ui.closeMenu, lang)} />
    </button>
  </div>
  <nav aria-label={tr(ui.menu, lang)}>
    <ul class="menu__nav" role="list">
      {nav.map((item, i) => (
        <li style={`--i:${i}`}>
          <a href={href(item.href, lang)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {tr(item.label, lang)}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="menu__bottom">
    <a class="btn btn--primary" href="#contacto" data-menu-close>{tr(ui.bookCta, lang)}</a>
    <ul class="menu__contact" role="list">
      {whatsapp && (
        <li><a href={whatsapp.href} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> {whatsapp.label}</a></li>
      )}
      {phone && <li><a href={phone.href}><Icon name="phone" size={18} /> {phone.label}</a></li>}
      <li><a href={contact.emailHref}><Icon name="mail" size={18} /> {contact.email}</a></li>
    </ul>
    <div class="menu__tools">
      <div class="hd__lang" role="group" aria-label={tr(ui.language, lang)}>
        {langs.map((l) => (
          <a href={switchLang(path, l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>
            {l.toUpperCase()}
          </a>
        ))}
      </div>
      <ThemeToggle lang={lang} />
    </div>
  </div>
</dialog>

<style>
  /* ---------------- Barra ---------------- */
  .hd {
    --p: 0;                 /* progreso de scroll 0 → 1 */
    --cx: 0px;              /* recogida horizontal de cada lado */
    --bar-h: 3.5rem;
    position: fixed;
    inset: var(--space-xs) 0 auto;
    z-index: var(--z-header);
    padding-inline: var(--gutter);
    color: var(--ink);
    pointer-events: none;
  }
  .hd[data-over-hero] {
    color: color-mix(in oklab, var(--ink) calc(var(--p) * 100%), var(--on-photo));
  }
  .hd__bg {
    position: absolute;
    inset: 0 calc(var(--cx) - var(--space-s));
    border-radius: var(--r-md);
    background: var(--glass);
    backdrop-filter: blur(28px) saturate(1.3);
    -webkit-backdrop-filter: blur(28px) saturate(1.3);
    box-shadow: var(--shadow-1);
    opacity: var(--p);
  }
  .hd__bar {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--bar-h);
    max-width: var(--page-max);
    margin-inline: auto;
  }
  .hd__group,
  .hd__logo { position: relative; }
  .hd__group {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    pointer-events: auto;
  }
  .hd__group--center { justify-content: center; }
  .hd__group--end {
    justify-content: flex-end;
    transform: translateX(calc(var(--cx) * -1));
  }
  .hd__nav {
    display: flex;
    width: max-content;
    gap: var(--space-m);
  }
  .hd__link {
    position: relative;
    font-size: var(--step--1);
    font-weight: var(--w-medium);
    text-decoration: none;
    white-space: nowrap;
    padding-block: 0.5rem;
  }
  /* Subrayado que crece desde la izquierda */
  .hd__link::after {
    content: '';
    position: absolute;
    inset: auto 0 0.2rem;
    height: 1.5px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur-2) var(--ease-out);
  }
  .hd__link[aria-current='page']::after { transform: scaleX(1); }
  @media (hover: hover) {
    .hd__link:hover::after { transform: scaleX(1); transform-origin: left; }
  }
  .hd__logo {
    pointer-events: auto;
    display: block;
    justify-self: start;
    transform: translateX(var(--cx));
  }
  .hd__logo :global(.logo) {
    height: 2.9rem;
    transform: scale(calc(1 - var(--p) * 0.22));
    transform-origin: left center;
  }
  .hd__lang {
    display: flex;
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: var(--track-label);
  }
  .hd__lang a {
    padding: 0.6rem 0.4rem;
    text-decoration: none;
    opacity: 0.6;
    transition: opacity var(--dur-1) var(--ease-out);
  }
  .hd__lang a[aria-current='true'],
  .hd__lang a:hover { opacity: 1; }
  .hd__cta { min-height: 2.5rem; padding: 0.7rem 1.2rem; }

  /* Botón de menú (móvil): dos líneas que se cruzan */
  .hd__burger {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border-radius: var(--r-pill);
  }
  .hd__burger-lines { display: grid; gap: 6px; width: 22px; }
  .hd__burger-lines span {
    height: 1.5px;
    background: currentColor;
    transition: transform var(--dur-2) var(--ease-out);
  }

  @media (max-width: 68rem) {
    .hd__nav,
    .hd__group--end > .hd__lang,
    .hd__group--end > :global(.theme-toggle),
    .hd__cta { display: none; }
    .hd__burger { display: grid; }
    .hd__bar { grid-template-columns: auto 1fr; }
    .hd__logo { transform: none; }
    .hd__logo :global(.logo) { height: 2.5rem; }
    .hd__group--center { display: none; }
    .hd__bg { inset: 0 calc(var(--space-s) * -1); }
    .hd__group--end { transform: none; }
  }

  /* ---------------- Menú móvil ---------------- */
  .menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: var(--space-xs) var(--gutter) var(--space-l);
    border: 0;
    background: var(--bg);
    color: var(--ink);
    display: none;
    flex-direction: column;
    gap: var(--space-xl);
    overflow-y: auto;
  }
  .menu[open] { display: flex; }
  .menu::backdrop { background: transparent; }
  .menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.5rem;
  }
  .menu__logo :global(.logo) { height: 2.5rem; }
  .menu__close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--r-pill);
    border: 1px solid var(--line-strong);
  }
  .menu__nav { display: grid; gap: var(--space-2xs); }
  .menu__nav a {
    display: block;
    font-size: var(--step-4);
    font-weight: var(--w-light);
    letter-spacing: var(--track-display);
    line-height: 1.1;
    text-decoration: none;
    transition: font-weight var(--dur-2) var(--ease-out);
  }
  .menu__nav a[aria-current='page'],
  .menu__nav a:hover { font-weight: var(--w-bold); }
  .menu__bottom {
    margin-top: auto;
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }
  .menu__contact { display: grid; gap: var(--space-xs); color: var(--ink-2); }
  .menu__contact a { display: inline-flex; gap: 0.6em; align-items: center; text-decoration: none; }
  .menu__tools { display: flex; align-items: center; gap: var(--space-s); }

  /* Entrada escalonada */
  .menu[open] .menu__nav li,
  .menu[open] .menu__bottom {
    animation: menu-in var(--dur-3) var(--ease-out) both;
    animation-delay: calc(80ms + var(--i, 4) * 60ms);
  }
  @keyframes menu-in {
    from { opacity: 0; transform: translateY(var(--reveal-distance)); }
  }
  :global(html:has(.menu[open])) { overflow: hidden; }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const bar = header.querySelector<HTMLElement>('.hd__bar')!;
    const center = header.querySelector<HTMLElement>('.hd__group--center')!;
    const end = header.querySelector<HTMLElement>('.hd__group--end')!;
    const logo = header.querySelector<HTMLElement>('.hd__logo')!;
    // La píldora abraza el contenido: secciones al centro + el lado más ancho (logo o herramientas) a cada lado.
    const breathing = 40;
    let max = 0;
    const measure = () => {
      const span = (el: HTMLElement) => {
        const rects = [...el.children].map((c) => c.getBoundingClientRect()).filter((r) => r.width > 0);
        if (!rects.length) return 0;
        return Math.max(...rects.map((r) => r.right)) - Math.min(...rects.map((r) => r.left));
      };
      const side = Math.max(logo.offsetWidth, span(end));
      const needed = span(center.firstElementChild as HTMLElement) + side * 2 + breathing * 2;
      max = Math.max((bar.clientWidth - needed) / 2, 0);
    };
    let target = 0;
    let current = 0;
    let raf = 0;
    const apply = () => {
      header.style.setProperty('--p', current.toFixed(4));
      header.style.setProperty('--cx', `${(max * current).toFixed(2)}px`);
    };
    const tick = () => {
      current += (target - current) * 0.14;
      if (Math.abs(target - current) < 0.001) current = target;
      apply();
      raf = current === target ? 0 : requestAnimationFrame(tick);
    };
    const onScroll = () => {
      target = Math.min(scrollY / 140, 1);
      if (reduce.matches) {
        current = target > 0.5 ? 1 : 0;
        apply();
        return;
      }
      if (!raf) raf = requestAnimationFrame(tick);
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', () => { measure(); apply(); });
    document.fonts?.ready.then(() => { measure(); apply(); });
    measure();
    onScroll();
  }

  // Menú móvil: <dialog> nativo (Escape, foco atrapado).
  const dialog = document.querySelector<HTMLDialogElement>('[data-menu]');
  const opener = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  if (dialog && opener) {
    opener.addEventListener('click', () => {
      dialog.showModal();
      opener.setAttribute('aria-expanded', 'true');
    });
    dialog.addEventListener('close', () => {
      opener.setAttribute('aria-expanded', 'false');
      opener.focus();
    });
    dialog.querySelectorAll('[data-menu-close]').forEach((el) =>
      el.addEventListener('click', () => dialog.close()),
    );
    matchMedia('(min-width: 68.001rem)').addEventListener('change', (e) => {
      if (e.matches && dialog.open) dialog.close();
    });
  }
</script>
