---
/**
 * Foto optimizada: WebP en varios anchos + `sizes` para que el navegador
 * descargue solo lo necesario. `src` es la ruta del archivo de contenido.
 */
import { Image } from 'astro:assets';
import { asset } from '@/lib/images';

interface Props {
  src: string;
  alt: string;
  /** Ancho aproximado en pantalla, p. ej. "(max-width: 48rem) 100vw, 33vw". */
  sizes: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  style?: string;
}
const { src, alt, sizes, widths, loading = 'lazy', fetchpriority, class: cls, style } = Astro.props;
const meta = asset(src);
const w = (widths ?? [320, 480, 640, 960, 1280, 1600, 2000]).filter((x) => x <= meta.width);
if (!w.length || w[w.length - 1] < Math.min(meta.width, 2000)) w.push(Math.min(meta.width, 2000));
---
<Image
  src={meta}
  alt={alt}
  widths={w}
  sizes={sizes}
  format="webp"
  quality={78}
  loading={loading}
  fetchpriority={fetchpriority}
  decoding="async"
  class={cls}
  style={style}
/>
